# Copy to backend/.env for local development (never commit .env)

OPENAI_API_KEY=
OPENWEATHER_API_KEY=
SUPABASE_DB_URI=

# Max LLM tokens per IP+device per UTC day (default 40000)
DAILY_TOKEN_BUDGET=40000

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regex for Appwrite Sites (default in app.py). Empty string disables.
# CORS_ORIGIN_REGEX=https://.*\.appwrite\.network
